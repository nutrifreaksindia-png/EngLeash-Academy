# --- Copy this file to `.env` on the server:  cp .env.example .env
#
# === Step 1 — always set these for production ===
# JWT: sign login tokens. Generate with:  openssl rand -base64 48
JWT_SECRET=

# API public URL (no trailing slash). Used by web-admin at **build** time and by API for absolute links.
VITE_API_BASE=https://api.engleashacademy.com
API_URL=https://api.engleashacademy.com

# === Step 2 — optional overrides (defaults are fine in Docker) ===
# PORT=3001
# BIND_HOST=0.0.0.0
# If you use a different CDN/base for stored files than API_URL:
# STORAGE_URL=https://api.engleashacademy.com

# Assignment response Spaces prune interval (default 6 hours). Retention days are set in Admin → Settings.
# ASSIGNMENT_RESPONSE_PRUNE_MS=21600000

# === Step 3 — DigitalOcean Spaces (needed for video uploads & study-material assets) ===
# In DO: Spaces → your Space → Settings: Origin Endpoint host (no https://) → SPACES_ENDPOINT
# Bucket name → SPACES_BUCKET
# API → Spaces Keys → Generate → SPACES_KEY / SPACES_SECRET
# SPACES_REGION=us-east-1
# Optional CDN subdomain if enabled → SPACES_CDN_BASE_URL=https://your-space.region.cdn.digitaloceanspaces.com
# SPACES_OBJECT_ACL=public-read

# SPACES_ENDPOINT=
# SPACES_BUCKET=
# SPACES_KEY=
# SPACES_SECRET=

# === Step 4 — Live classes (LiveKit self-hosted) ===
# LIVEKIT_URL=wss://livekit.engleashacademy.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_TOKEN_EXPIRY_SECONDS=3600
