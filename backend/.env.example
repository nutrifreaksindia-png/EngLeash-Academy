PORT=3001
JWT_SECRET=your-super-secret-key-change-in-production
API_URL=http://localhost:3001
STORAGE_URL=http://localhost:3001/uploads

# DigitalOcean Spaces (pre-recorded lesson videos)
# Example endpoint for Singapore: sgp1.digitaloceanspaces.com
SPACES_ENDPOINT=
SPACES_REGION=us-east-1
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
SPACES_OBJECT_ACL=public-read
# Optional: if CDN is enabled, use CDN base URL for video playback
SPACES_CDN_BASE_URL=
# Agora RTC (live classes). Install npm package: agora-access-token
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Token privilege TTL (seconds). Optional; default used by SDK builder if unset elsewhere.
AGORA_TOKEN_EXPIRY_SECONDS=3600

# Live join policy: students/labs may join only between (starts_at − early) and ends_at unless session is already live.
# Admins and batch trainers bypass the time window. Values in milliseconds.
LIVE_JOIN_EARLY_MS=1800000

# For production (Hostinger) use MySQL - see docs
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_USER=...
# DB_PASSWORD=...
# DB_NAME=...
